DEBUG=True

### Service ports (local dev + Docker Compose host mappings)
# Django dev server / Gunicorn bind address
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Gunicorn port inside the web container (usually matches WEB_PORT)
WEB_CONTAINER_PORT=8000
# Host ports published by docker-compose (connect from your machine)
DB_PORT_EXPOSE=5432
REDIS_PORT_EXPOSE=6379

### Security related settings
# Generate a new secret key for your django project here: https://djast.dev/tools/django-secret-key-generator/
SECRET_KEY=YOUR_SECRET_KEY_HERE
# Comma-separated hostnames (no scheme). Production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,.vercel.app
# Comma-separated origins with scheme (for API CORS + CSRF). Production: https://yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# Restrict access to different pages based on authentication (user_management/middleware.py)
AUTHENTICATION_REQUIRED=True
ACCOUNT_USERNAME_REQUIRED=True
ACCOUNT_EMAIL_REQUIRED=True
ACCOUNT_AUTHENTICATION_METHOD='username_email'
# Send a verification email, but don't require it for login
ACCOUNT_EMAIL_VERIFICATION='optional'
# Number of failed login attempts allowed before locking the user account
AXES_FAILURE_LIMIT=10
# Time to lock the user account after too many failed login attempts
AXES_COOLOFF_TIME=1 
# Reset the number of failed login attempts on successful login
AXES_RESET_ON_SUCCESS=True

### Google OAuth settings
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_SECRET=YOUR_GOOGLE_SECRET

### Google Analytics settings
GOOGLE_ANALYTICS_ID=YOUR_GOOGLE_ANALYTICS_ID
# When True: Consent Mode v2 default-denied + Accept/Reject banner (required for EEA)
CONSENT_REQUIRED=False
# Enable GA4 DebugView (defaults to DEBUG value)
GA_DEBUG_MODE=True

### GitHub OAuth settings
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_SECRET=YOUR_GITHUB_SECRET

### Email configuration (for automated verification emails and use with send_email function)
RESEND_API_KEY=YOUR_RESEND_API_KEY
DEFAULT_FROM_EMAIL=YOUR_DEFAULT_FROM_EMAIL

### Stripe Configuration
## Replace the following keys with your own Stripe keys (to use in Production)
STRIPE_PUBLIC_KEY=YOUR_STRIPE_PUBLIC_KEY
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
PRODUCT_PRICE_ID=YOUR_PRODUCT_PRICE_ID
COUPON_ID=YOUR_COUPON_ID
REDIRECT_DOMAIN=http://127.0.0.1:8000/payment
# Defaults to http://${WEB_HOST}:${WEB_PORT}/payment when unset

## Test Stripe keys to be used for testing (when DEBUG is set to True)
TEST_STRIPE_PUBLIC_KEY=YOUR_TEST_STRIPE_PUBLIC_KEY
TEST_STRIPE_SECRET_KEY=YOUR_TEST_STRIPE_SECRET_KEY
TEST_STRIPE_WEBHOOK_SECRET=YOUR_TEST_STRIPE_WEBHOOK_SECRET
TEST_PRODUCT_PRICE_ID=YOUR_TEST_PRODUCT_PRICE_ID
TEST_COUPON_ID=YOUR_TEST_COUPON_ID
TEST_REDIRECT_DOMAIN=http://YOUR_DOMAIN_HERE/payment

## Payment methods that can be used by the user
PAYMENT_METHODS=card,link

### Database configuration (PostgreSQL when DEBUG=False)
DB_NAME=postgres
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
# Docker deploy: creates admin user on first boot when both DB_* are set (optional email override)
# SUPERUSER_EMAIL=admin@yourdomain.com
# Local dev: localhost. Docker Compose: db (see docker-compose.yml environment defaults)
DB_HOST=localhost
DB_PORT=5432

### Celery & Redis configuration
# Local dev: localhost. Docker Compose: redis service hostname
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave CELERY_BROKER_URL unset to auto-build from REDIS_HOST/REDIS_PORT in settings.py
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Django cache (leave empty for in-memory cache)
REDIS_URL=redis://localhost:6379/1

### Docker Compose (local: src/src/.env — Dokploy: Environment tab → repo-root .env)
# DB_NAME/DB_USER/DB_PASSWORD must match what the db service provisions (see docker-compose.yml defaults).
# DB_HOST=db
# DB_PORT=5432
# REDIS_HOST=redis
# REDIS_PORT=6379
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# REDIS_URL=redis://redis:6379/1
# DEBUG=False
# DB_PORT_EXPOSE=5432
# REDIS_PORT_EXPOSE=6379
# WEB_HOST=0.0.0.0
# WEB_PORT=8000
# WEB_CONTAINER_PORT=8000
# CELERY_CONCURRENCY=2

### Viator Partner API (tours tab — /api/v3/events/tours)
# Basic-access affiliate key from Viator Partner Platform (exp-api-key header)
VIATOR_API_KEY=
VIATOR_PARTNER_ID=P00222801
VIATOR_CAMPAIGN=sao-miguel-tours
# Viator destination id for São Miguel (optional — auto-resolved via /destinations if empty)
VIATOR_DESTINATION_ID=
VIATOR_BASE_URL=https://api.viator.com/partner

### Open-Meteo (parish weather — /api/v3/weather/parishes)
# No API key required for non-commercial use (CC BY 4.0 attribution in responses)
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# OPEN_METEO_TIMEOUT=25

### PDL Mini Bus live tracking (Eleven Systems AVL — /api/v3/minibus/vehicles)
# Public upstream at pdl.elevensystems.pt (not tracking.elevensystems.pt — that is the vendor site)
# MINIBUS_TRACKING_BASE_URL=https://pdl.elevensystems.pt/publicapi
# MINIBUS_TRACKING_TIMEOUT=10
# Cache age in seconds — primary ops tuning knob (lower = fresher, more upstream load)
# MINIBUS_TRACKING_CACHE_TTL=10
# Serve last good snapshot on upstream failure up to this many seconds after fetch
# MINIBUS_TRACKING_STALE_GRACE=60
# Single-flight lock TTL while one worker refreshes the cache
# MINIBUS_TRACKING_LOCK_TTL=5

# Legacy import (400MB+ JSON) — per-task limits override the 30m default
# LEGACY_IMPORT_TASK_TIME_LIMIT=21600
# LEGACY_IMPORT_TASK_SOFT_TIME_LIMIT=18000
# GUNICORN_WORKERS=3

### Account auth + native social sign-in (/api/v3/auth/*)
# Apple "Sign in with Apple" allowed audiences (app bundle id(s), comma-separated).
# Clearing this hides the Apple button in the mobile app (via /api/v3/bootstrap socialAuth).
APPLE_BUNDLE_IDS=com.sousadev.saomiguelhub,com.hsousa-apps.Autocarros
# Google OAuth client ids accepted as id_token audiences (iOS + Android + web), comma-separated.
# Clearing this hides the Google button in the mobile app without an app rebuild.
GOOGLE_OAUTH_CLIENT_IDS=

### Billing — RevenueCat reconcile webhook (future IAP seam, /api/v3/billing/webhooks/revenuecat)
# Shared secret sent by RevenueCat in the Authorization header
REVENUECAT_WEBHOOK_SECRET=
